# Environment and secrets — CRITICAL, never commit
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tests / tooling
.pytest_cache/

# Notebooks — research only, keep out of git
notebooks/
.ipynb_checkpoints/

# Model cache (sentence-transformers downloads bge-m3 locally)
.cache/
models/

# Grouping internal state, if ever written to disk locally
*.pkl

# Logs
*.log
logs/

# Database dumps — backups live outside the repo (~/backups/postgres);
# this is insurance in case one is ever written in here by accident.
backups/
*.dump

# OS
.DS_Store