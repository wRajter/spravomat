# Database — locally points to your local Postgres.
# On Heroku it is set automatically (Postgres addon), no need to set here.
DATABASE_URL=postgresql://localhost:5432/spravomat_dev

# LLM enrichment (provider parked — key depends on choice)
LLM_API_KEY=

# LLM comparison test (tests/enrichment_comparison.py) — throwaway experiment.
# Fill only the ones you want to compare; the script skips any that are unset.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Runtime
DEBUG=true
LOG_LEVEL=INFO