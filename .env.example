# Copy to .env (never commit .env). Compose reads this file for the ${...} values
# in docker-compose.yml; the same file works for local dev.

# --- Postgres (the db container) ---
POSTGRES_USER=spravomat
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=spravomat

# --- App DB connection ---
# On the server, host is the compose service name `db`; keep user/password/db in
# sync with the POSTGRES_* values above. For local dev, point it at your local
# Postgres instead (e.g. postgresql://localhost:5432/spravomat_dev).
DATABASE_URL=postgresql://spravomat:change-me-to-a-strong-password@db:5432/spravomat

# --- Gemini (batch enrichment) ---
# Without it, story cards degrade to keyword titles (no crash).
GEMINI_API_KEY=

# --- Runtime ---
LOG_LEVEL=INFO
DEBUG=false

# --- Alerting (Telegram) ---
# Used by scripts/notify.sh to alert on failed batch runs and failed backups.
# Leave empty to disable alerting: the ops scripts log a warning and carry on.
# Token: message @BotFather -> /newbot. Chat ID: send your new bot a message,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates and read chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: throwaway LLM comparison tests only (not needed to deploy/run) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
